# Sanctuary gateway settings, as compose.yaml runs it. Every setting is also
# a flag (sanctuary-gateway -help lists them all) and an environment
# variable of the same name, and the environment overrides this file, so
# `doppler run -- docker compose up` or a CI secret can change any of it.
#
# Secrets (private keys, ACCOUNT_KEY) appear here only as paths (..._FILE). Their
# content may come from the environment instead, never from this file.

SANCTUARY_NAME=Sanctuary
SANCTUARY_PUBLIC_HOST=localhost
SANCTUARY_TELNET=:9000
SANCTUARY_TELNETS=:9010
SANCTUARY_WS=:9020
SANCTUARY_LOG_LEVEL=info

# Accounts live on the gateway-data volume (compose.yaml). Who may sign up:
# open, invite or staff. Plain telnet logins are allowed with a warning
# unless REFUSE_PLAINTEXT_LOGIN is true.
SANCTUARY_DATA_DIR=/data
SANCTUARY_SIGNUP=open
SANCTUARY_REFUSE_PLAINTEXT_LOGIN=false
# Extra reserved account names, comma-separated, added to the built-in list
# (admin, staff, system, ...); RESERVED_NAMES_REPLACE=true uses only these.
SANCTUARY_RESERVED_NAMES=
SANCTUARY_RESERVED_NAMES_REPLACE=false
# A connection that has not logged in by then is closed.
SANCTUARY_LOGIN_TIMEOUT=2m

# Realms run as their own containers, so no in-process stub.
SANCTUARY_STUB_REALM=false

# The realm port. compose.yaml does not publish it: only containers on the
# compose network can reach it, and only with a pinned certificate.
SANCTUARY_REALM_LISTEN=:9030

# The realm-port identity and the realm pins differ per environment, so
# they are not here. compose.yaml reads them from a second env file:
# .dev/env/gateway.env (scripts/devkeys.sh) or Doppler
# (scripts/compose.sh -doppler stg).
