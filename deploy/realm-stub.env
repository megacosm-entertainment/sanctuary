# Stub realm settings, as compose.yaml runs it. Every setting is also a flag
# (sanctuary-realm -help) and an environment variable of the same name; the
# environment overrides this file.

SANCTUARY_ID=stub
SANCTUARY_NAME=Stub realm
SANCTUARY_LOG_LEVEL=info

# The gateway's realm port, by its compose service name.
SANCTUARY_GATEWAY=gateway:9030

# This realm's identity and the gateway pin differ per environment, so they
# are not here. compose.yaml reads them from a second env file:
# .dev/env/realm-stub.env (scripts/devkeys.sh) or Doppler
# (scripts/compose.sh -doppler stg).
