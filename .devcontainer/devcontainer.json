{
    "name": "Sanctuary Dev Environment",
    // Built from docker/dev/Dockerfile, which provides Go (the security floor
    // in go.mod), the race detector's C toolchain and Claude Code. The old C
    // engine's toolchain is in the separate legacy image.
    "image": "ghcr.io/megacosm-entertainment/sanctuary:dev_01",
    "remoteUser": "sanctuary",
    "workspaceFolder": "/sanctuary/src",
    // The parent folder is mounted so ../old_game is available for reference
    // (see CLAUDE.md for the rules on reading it).
    "workspaceMount": "source=${localWorkspaceFolder}/..,target=/sanctuary,type=bind",
    "mounts": [
        // Keeps the Claude Code login and settings across container rebuilds.
        "source=sanctuary-claude,target=/home/sanctuary/.claude,type=volume"
    ],
    "forwardPorts": [9000, 9010, 9020],
    "portsAttributes": {
        "9000": { "label": "Telnet" },
        "9010": { "label": "TLS" },
        "9020": { "label": "WebSocket" }
    },
    "runArgs": [
        // Lets a debugger (Delve) attach. Docker's default seccomp profile
        // permits ptrace once this capability is granted, so seccomp stays on.
        "--cap-add=SYS_PTRACE"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "golang.go",
                "eamodio.gitlens"
            ],
            "settings": {
                "editor.tabSize": 4,
                "editor.insertSpaces": true,
                // Commits are signed (repo-local commit.gpgsign and
                // user.signingkey). Dev Containers forwards the host's gpg
                // agent, so the key works here without being copied in.
                "git.enableCommitSigning": false,
                "remote.SSH.enableAgentForwarding": true,
                "git.useConfigOnly": false,
                "terminal.integrated.cwd": "/sanctuary/src"
            }
        }
    }
}
